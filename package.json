    "test:payments": "node --experimental-strip-types --experimental-test-module-mocks --experimental-loader ./tests/alias-loader.mjs --test tests/payments-offline.test.mjs tests/receipt.test.mjs tests/financial-cache-rules.test.mjs tests/cash-balances.test.mjs"
  },
  "dependencies": {
    "dexie": "^4.4.5",
    "lucide-react": "^0.469.0",
    "next": "15.5.21",
    "qrcode": "^1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-to-print": "^3.3.0"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.13",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.7",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
